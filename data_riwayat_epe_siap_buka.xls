   <Row>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="Number">25</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">2026-09-14 14:10</Data></Cell>
    <Cell ss:StyleID="BoldCell"><Data ss:Type="String">Wahyu Setiawan (Siswa_23)</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">Q23</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">D6 - Penerapan</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">[E4] Interpretasi: Menentukan Waktu Sentuh Tanah Parabola</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">[E2] Prosedural</Data></Cell>
    <Cell ss:StyleID="CenterCell"><Data ss:Type="String">83%</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Siswa memilih t = 0 sebagai waktu peluru menyentuh tanah kembali bukannya t = 4.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Nilai t = 0 adalah saat peluru ditembakkan, sedangkan saat menyentuh tanah kembali adalah akar t positif kedua.</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">t = 0 detik</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">h(t) = 40t - 5t^2 = 0
5t(8 - t) = 0
t = 0 atau t = 8
Siswa memilih t = 0</Data></Cell>
   </Row>
